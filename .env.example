# ============================================
# WAGERIE - ENVIRONMENT VARIABLES
# ============================================

# Copy this file to .env.local and update values

# ========== API CONFIGURATION ==========
NEXT_PUBLIC_BASE_API_URL=http://localhost:3000/api

# ========== AUTHENTICATION ==========
# OAuth configuration (optional for Phase 1)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ========== PAYMENT PROCESSORS ==========
# Phase 2: Payment integration
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your-stripe-key
# STRIPE_SECRET_KEY=your-stripe-secret

# ========== ANALYTICS (Optional) ==========
# NEXT_PUBLIC_GA_ID=your-ga-id

# ========== NOTIFICATIONS ==========
# Phase 2: Real-time notifications
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
